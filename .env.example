# Copy to .env. Never commit .env.
DATABASE_URL=postgresql+psycopg://apple@localhost:5432/retriever
DRY_RUN=true
DEMO_PASSWORD=retriever-demo

# HitPay sandbox. Signature algorithm is unverified; the app treats
# Hitpay-Signature as hex HMAC-SHA256 over the raw body (see CHALLENGES.md).
HITPAY_API_KEY=
HITPAY_WEBHOOK_SALT=sandbox-salt
HITPAY_ENV=sandbox
HITPAY_API_BASE=https://api.sandbox.hit-pay.com

# Stripe test mode. F15 Custom Payment Methods are not implemented.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_test

# xAI Grok. Empty key forces the rules-v1 fallback for tier-3 matches.
XAI_API_KEY=
LLM_MODEL=grok-4-fast
LLM_BASE_URL=https://api.x.ai/v1

CHURN_AFTER_DAYS=7
ABANDON_AFTER_MINUTES=30
