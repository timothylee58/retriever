# Copy to .env and fill the blanks. Never commit .env.
#
# Leave DRY_RUN=true until a sandbox payment request succeeds.
# The API reads this file from the repo root when you start uvicorn there.

DATABASE_URL=postgresql+psycopg://apple@localhost:5432/retriever
DRY_RUN=true
DEMO_PASSWORD=retriever-demo
# Comma-separated browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000

# --- HitPay sandbox (not the live dashboard) ---
# Sandbox: https://sandbox.hit-pay.com
# API key: Developers → API keys. This is not the webhook salt.
HITPAY_API_KEY=
# Salt of ONE webhook endpoint: Developers → Webhook Endpoints → that endpoint's detail.
# Do not paste the API-key salt from the main Developers page. Event webhooks
# sign the raw body with this salt and send it in the Hitpay-Signature header.
HITPAY_WEBHOOK_SALT=
# Public HTTPS URL printed by `hitpay listen` (the loca.lt tunnel), not localhost.
# A payment link only notifies Retriever when this is set before the link is created.
HITPAY_WEBHOOK_URL=
HITPAY_ENV=sandbox
HITPAY_API_BASE=https://api.sandbox.hit-pay.com

# --- Stripe test mode ---
# Dashboard in test mode. sk_test_… and the whsec_… from `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Custom Payment Methods (F15). Leave empty unless the Stripe account is
# business-verified. Dashboard: Settings → Payments → Custom payment methods.
# Each id starts with cpmt_. The app does not read these yet.
STRIPE_CPM_PAYNOW=
STRIPE_CPM_GRABPAY=
STRIPE_CPM_SHOPEEPAY=
STRIPE_CPM_FPX=
STRIPE_CPM_TNG=

# --- xAI Grok (optional). Empty key uses the rules-v1 matcher. ---
XAI_API_KEY=
LLM_MODEL=grok-4-fast
LLM_BASE_URL=https://api.x.ai/v1

CHURN_AFTER_DAYS=7
ABANDON_AFTER_MINUTES=30

# HitPay hosted MCP (https://mcp.hit-pay.com/) has no key in this file.
# It is live-only and signs in with your HitPay login (OAuth).
