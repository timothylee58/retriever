{
  "name": "retriever-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "containers": [
    {
      "class_name": "RetrieverApi",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "../../Dockerfile",
          "build_context": "../.."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RETRIEVER_API", "class_name": "RetrieverApi" }
    ]
  },
  "exports": {
    "RetrieverApi": { "type": "durable-object", "storage": "sqlite" }
  }
}
